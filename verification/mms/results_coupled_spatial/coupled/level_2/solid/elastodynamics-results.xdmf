<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="http://www.w3.org/2001/XInclude">
  <Domain>
    <Grid Name="TimeSeries" GridType="Collection" CollectionType="Temporal">
      <Grid Name="mesh" GridType="Uniform">
        <Topology NumberOfElements="256" TopologyType="Triangle" NodesPerElement="3">
          <DataItem Dimensions="256 3" NumberType="UInt" Format="HDF">elastodynamics-results.h5:/Mesh/0/mesh/topology</DataItem>
        </Topology>
        <Geometry GeometryType="XY">
          <DataItem Dimensions="153 2" Format="HDF">elastodynamics-results.h5:/Mesh/0/mesh/geometry</DataItem>
        </Geometry>
        <Time Value="0.01" />
        <Attribute Name="PlateDisplacement" AttributeType="Vector" Center="Node">
          <DataItem Dimensions="153 3" Format="HDF">elastodynamics-results.h5:/VisualisationVector/0</DataItem>
        </Attribute>
      </Grid>
      <Grid>
        <xi:include xpointer="xpointer(//Grid[@Name=&quot;TimeSeries&quot;]/Grid[1]/*[self::Topology or self::Geometry])" />
        <Time Value="0.02" />
        <Attribute Name="PlateDisplacement" AttributeType="Vector" Center="Node">
          <DataItem Dimensions="153 3" Format="HDF">elastodynamics-results.h5:/VisualisationVector/1</DataItem>
        </Attribute>
      </Grid>
      <Grid>
        <xi:include xpointer="xpointer(//Grid[@Name=&quot;TimeSeries&quot;]/Grid[1]/*[self::Topology or self::Geometry])" />
        <Time Value="0.029999999999999999" />
        <Attribute Name="PlateDisplacement" AttributeType="Vector" Center="Node">
          <DataItem Dimensions="153 3" Format="HDF">elastodynamics-results.h5:/VisualisationVector/2</DataItem>
        </Attribute>
      </Grid>
    </Grid>
  </Domain>
</Xdmf>
